{
  "functions": {
    "api/index.py": {
      "runtime": "python3.9",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "PORTFOLIO_KEY": "@portfolio_key",
    "GITHUB_TOKEN": "@github_token",
    "REPO_OWNER": "@repo_owner",
    "REPO_NAME": "@repo_name"
  }
}
